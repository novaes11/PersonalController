#!/bin/sh
# Pre-push hook: impede push direto para a branch main.
# Para subir mudanças na main, abra uma feature branch e crie um Pull Request.

remote="$1"
url="$2"

RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m'

while read local_ref local_oid remote_ref remote_oid
do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    printf "${RED}[BLOQUEADO]${NC} Pushes diretos para a branch ${YELLOW}main${NC} são estritamente proibidos!\n"
    printf "Por favor, crie uma branch de funcionalidade e abra um Pull Request para revisão e merge.\n"
    exit 1
  fi
done

exit 0
