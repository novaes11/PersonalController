# ============================================================
# TEMPLATE de variáveis de ambiente — SEM valores reais.
# Copie para `.env` (ignorado pelo git) e preencha localmente:
#   cp .env.example .env
# NUNCA commite o `.env`. Em produção (Cloud Run / Vercel) use o
# gerenciador de secrets da plataforma, não arquivos.
# ============================================================

# --- Supabase ---------------------------------------------------
# Públicas (podem ir para o frontend; a segurança vem do RLS)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# PRIVADA: ignora o RLS. Somente backend (FastAPI/worker). NUNCA no frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Segredo para validar a assinatura dos JWTs no backend (SEC-03)
SUPABASE_JWT_SECRET=

# --- APIs de cotação (Fase Portfolio) ---------------------------
BRAPI_TOKEN=
# AwesomeAPI e CoinGecko (plano free) não exigem chave

# --- Backend ----------------------------------------------------
APP_ENV=development
CORS_ALLOWED_ORIGINS=http://localhost:5173
